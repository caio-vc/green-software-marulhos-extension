{
  "manifest_version": 3,
  "name": "Marulhos Contador de Reservas/Unidades",
  "version": "1.1.5",
  "description": "Conta unidades presentes no Green Software - Dev Caio Vinícius",
  "permissions": [
    "activeTab",
    "scripting",
    "storage"
  ],
  "content_scripts": [
    {
      "matches": [
        "*://greensoftware.com.br/marulhos/*",
        "*://adm.gbdata.srv.br/marulhos/*"
      ],
      "js": ["lock-data.js", "locks.js"],
      "css": ["locks.css"],
      "all_frames": true,
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["locks.json"],
      "matches": [
        "*://greensoftware.com.br/*",
        "*://adm.gbdata.srv.br/*"
      ]
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_icon": "icon.png"
  },
  "icons": {
    "128": "icon.png"
  },
  "author": "Caio Vinícius"
}
